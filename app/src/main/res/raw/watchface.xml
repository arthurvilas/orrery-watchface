<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="themeColor" displayName="color_theme_name" defaultValue="0">
            <!-- Option 0: Default (Earth Blue) -->
            <!-- 1) Earth Fill: #FF77B5FE -->
            <!-- 2) Orbit Rings: #22FFFFFF -->
            <!-- 3) Noon/Midnight Line: #44FFFFFF -->
            <!-- 4) Sun Core: #FFFFF5D4 -->
            <!-- 5) Sun Glow: #33FFF5D4 -->
            <!-- 6) Meridian Line: #FFFF0000 -->
            <ColorOption id="0" displayName="earth_name" colors="#FF77B5FE #22FFFFFF #44FFFFFF #FFFFF5D4 #33FFF5D4 #FFFF0000" />

            <!-- Option 1: Monochrome -->
            <!-- Earth Fill: #FFAAAAAA (Light Gray) -->
            <!-- Orbit Rings: #44AAAAAA (Faint Light Gray) -->
            <!-- Noon/Midnight Line: #44AAAAAA (Faint Light Gray) -->
            <!-- Sun Core: #FFE0E0E0 (Very Light Gray) -->
            <!-- Sun Glow: #33E0E0E0 (Faint Very Light Gray) -->
            <!-- Meridian Line: #FFFF0000 (Red) -->
            <ColorOption id="1" displayName="monochrome_name" colors="#FFAAAAAA #44AAAAAA #44AAAAAA #FFE0E0E0 #33E0E0E0 #FFFF0000" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#000000">

        <!-- Thin gray line connecting Earth to Sun (noon-midnight line) -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Line startX="225" startY="225" endX="225" endY="450">
                <Stroke color="[CONFIGURATION.themeColor.2]" thickness="2" />
            </Line>
        </PartDraw>

        <!-- Earth Group (contains Earth sphere and user's meridian) -->
        <Group name="earth_group" x="213" y="213" width="24" height="24">
            <!-- Earth sphere (fixed in center) -->
            <PartDraw x="0" y="0" width="24" height="24">
                <Ellipse x="0" y="0" width="24" height="24">
                    <Fill color="[CONFIGURATION.themeColor.0]" />
                </Ellipse>
            </PartDraw>

            <!-- Rotating Meridian Group (extends 450px from center to screen edge) -->
            <Group name="meridian_group" x="-438" y="-438" width="900" height="900" pivotX="0.5" pivotY="0.5">
                <Transform target="angle" value="[HOUR_0_23] * 15 + [MINUTE] * 0.25" />

                <!-- Red line pointing outwards to the edge of the screen -->
                <PartDraw x="0" y="0" width="900" height="900">
                    <Line startX="450" startY="0" endX="450" endY="438">
                        <Stroke color="[CONFIGURATION.themeColor.5]" thickness="2" />
                    </Line>
                </PartDraw>
            </Group>
        </Group>

        <!-- Moon orbit ring (centered on Earth) -->
        <Group name="moon_orbit_group" x="190" y="190" width="70" height="70">
            <PartDraw x="0" y="0" width="70" height="70">
                <Arc centerX="35" centerY="35"
                     width="70" height="70"
                     startAngle="0" endAngle="360">
                    <Stroke color="[CONFIGURATION.themeColor.1]" thickness="2" />
                </Arc>
            </PartDraw>
        </Group>

        <!-- Moon: position derived from system [MOON_PHASE_POSITION] (0-28 lunar cycle). -->
        <Group name="moon_group" x="220" y="220" width="10" height="10">
            <!-- New Moon (phase 0) aligns with Sun at the bottom (+Y, or 90 degrees/1.5708 radians) -->
            <Transform target="x"
                value="225 + 35 * cos([MOON_PHASE_POSITION] * 0.2244 + 1.5708) - 5" />
            <Transform target="y"
                value="225 + 35 * sin([MOON_PHASE_POSITION] * 0.2244 + 1.5708) - 5" />
            <PartDraw x="0" y="0" width="10" height="10">
                <Ellipse x="0" y="0" width="10" height="10">
                    <Fill color="#FFEAEAEA" />
                </Ellipse>
            </PartDraw>
        </Group>

        <!-- Sun glow (fixed at bottom edge) -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="-25" y="370" width="500" height="500">
                <Fill color="[CONFIGURATION.themeColor.4]" />
            </Ellipse>
        </PartDraw>

        <!-- Sun core (fixed at bottom edge) -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="25" y="420" width="400" height="400">
                <Fill color="[CONFIGURATION.themeColor.3]" />
            </Ellipse>
        </PartDraw>
        
        <!-- Time Display -->
        <PartText x="0" y="45" width="450" height="80">
            <Text>
                <Font family="jetbrains_mono" size="76" color="#FFFFFFFF">
                    <Template>%s:%s
                        <Parameter expression="[HOUR_0_23_Z]" />
                        <Parameter expression="[MINUTE_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Date / Complication Slot -->
        <ComplicationSlot x="75" y="130" width="300" height="40" slotId="0" supportedTypes="SHORT_TEXT EMPTY">
            <DefaultProviderPolicy defaultSystemProvider="DAY_AND_DATE" defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingBox x="0" y="0" width="300" height="40" />
            <Complication type="SHORT_TEXT">
                <!-- Group to center both Title and Text horizontally if both are present -->
                <Group name="short_text_group" x="0" y="0" width="300" height="40">
                    <PartText x="0" y="0" width="300" height="40">
                        <Text>
                            <Font family="jetbrains_mono" size="24" color="#FFCCCCCC">
                                <Template><![CDATA[%s %s]]>
                                    <Parameter expression="[COMPLICATION.TITLE]" />
                                    <Parameter expression="[COMPLICATION.TEXT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom Right Complication Slot 1 -->
        <ComplicationSlot x="280" y="220" width="167" height="40" slotId="1" supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY">
            <BoundingBox x="0" y="0" width="167" height="40" />
            <Complication type="SHORT_TEXT">
                <Group name="short_text_group" x="0" y="0" width="167" height="40">
                    <PartImage x="0" y="4" width="32" height="32" tintColor="#FFCCCCCC">
                        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                    </PartImage>
                    <PartText x="36" y="0" width="131" height="40">
                        <Text align="START">
                            <Font family="jetbrains_mono" size="22" color="#FFCCCCCC">
                                <Template><![CDATA[%s]]>
                                    <Parameter expression="[COMPLICATION.TEXT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="67" y="4" width="32" height="32" tintColor="#FFCCCCCC">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="67" y="4" width="32" height="32">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom Right Complication Slot 2 -->
        <ComplicationSlot x="280" y="270" width="153" height="40" slotId="2" supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY">
            <BoundingBox x="0" y="0" width="153" height="40" />
            <Complication type="SHORT_TEXT">
                <Group name="short_text_group" x="0" y="0" width="153" height="40">
                    <PartImage x="0" y="4" width="32" height="32" tintColor="#FFCCCCCC">
                        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                    </PartImage>
                    <PartText x="36" y="0" width="117" height="40">
                        <Text align="START">
                            <Font family="jetbrains_mono" size="22" color="#FFCCCCCC">
                                <Template><![CDATA[%s]]>
                                    <Parameter expression="[COMPLICATION.TEXT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="60" y="4" width="32" height="32" tintColor="#FFCCCCCC">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="60" y="4" width="32" height="32">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Bottom Right Complication Slot 3 -->
        <ComplicationSlot x="280" y="320" width="125" height="40" slotId="3" supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY">
            <BoundingBox x="0" y="0" width="125" height="40" />
            <Complication type="SHORT_TEXT">
                <Group name="short_text_group" x="0" y="0" width="125" height="40">
                    <PartImage x="0" y="4" width="32" height="32" tintColor="#FFCCCCCC">
                        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                    </PartImage>
                    <PartText x="36" y="0" width="89" height="40">
                        <Text align="START">
                            <Font family="jetbrains_mono" size="22" color="#FFCCCCCC">
                                <Template><![CDATA[%s]]>
                                    <Parameter expression="[COMPLICATION.TEXT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="46" y="4" width="32" height="32" tintColor="#FFCCCCCC">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="46" y="4" width="32" height="32">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
